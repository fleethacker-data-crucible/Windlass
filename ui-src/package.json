{
  "name": "windlass-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Windlass browser UI: Svelte 5 + TypeScript, Tailwind CSS 4, Lucide, on the Fleet Unified UI shell. Built off-workstation into ../ui/dist and served by Windlass itself.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "mock": "node tools/mock-windlass.mjs",
    "test:e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "1.54.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.3"
  }
}
